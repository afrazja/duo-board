# Copy to .env.local for local runs; set the same names in Vercel for the deployment.

# A Supabase project created for this app. Run supabase/schema.sql in its SQL editor once.
SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
SUPABASE_SERVICE_ROLE_KEY=

# The password that opens the page in a browser.
BOARD_PASSWORD=

# One token per assistant. Make each at least 32 random characters, e.g.
#   node -e "console.log('duo_claude_' + require('crypto').randomBytes(24).toString('hex'))"
#   node -e "console.log('duo_chatgpt_' + require('crypto').randomBytes(24).toString('hex'))"
BOARD_TOKEN_CLAUDE=
BOARD_TOKEN_CHATGPT=
