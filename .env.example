# Copy to .env.local for local runs; set the same names in Vercel for the deployment.

# A Supabase project created for this app. Run supabase/schema.sql and then
# supabase/accounts.sql in its SQL editor once.
SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
SUPABASE_ANON_KEY=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Existing installations keep these only so the first account can claim the
# old board and preserve both existing assistant connections. New installs
# can leave them empty after every legacy board has been claimed.
BOARD_PASSWORD=

# One legacy token per assistant. Make each at least 32 random characters, e.g.
#   node -e "console.log('duo_claude_' + require('crypto').randomBytes(24).toString('hex'))"
#   node -e "console.log('duo_chatgpt_' + require('crypto').randomBytes(24).toString('hex'))"
BOARD_TOKEN_CLAUDE=
BOARD_TOKEN_CHATGPT=
