# Copy to .env.local for local runs; set the same names in Vercel for the deployment.

# A Supabase project created for this app. Run supabase/schema.sql in its SQL editor once.
SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
SUPABASE_SERVICE_ROLE_KEY=

# The password that opens the page in a browser.
BOARD_PASSWORD=

# One token per assistant. Make each at least 32 random characters, e.g.
#   node -e "console.log('duo_claude_' + require('crypto').randomBytes(24).toString('hex'))"
#   node -e "console.log('duo_chatgpt_' + require('crypto').randomBytes(24).toString('hex'))"
BOARD_TOKEN_CLAUDE=
BOARD_TOKEN_CHATGPT=

# Accounts (optional). With these two set, the page uses Supabase Auth: each
# person signs up, gets a private board, and makes their own assistant tokens
# on the Connect page. Without them the board runs behind BOARD_PASSWORD with
# the two tokens above. Both values are in the Supabase dashboard under
# Project Settings > API (the anon/publishable key is safe to expose).
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# The email of the person who owned the board before accounts. When they sign
# up with it, the server hands them everything that exists today and turns the
# two tokens above into their account tokens, so their assistants keep working.
BOARD_OWNER_EMAIL=
