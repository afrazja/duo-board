{
  "name": "duo-board",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "bridge:verify": "node bridge/verify-connection.mjs",
    "bridge:verify-worker": "node bridge/verify-worker.mjs",
    "bridge:start": "node bridge/helper.mjs",
    "bridge:connect": "node bridge/connect.mjs",
    "bridge:control": "node bridge/control.mjs",
    "bridge:startup": "powershell.exe -NoProfile -File bridge/startup.ps1",
    "build:companion": "powershell.exe -NoProfile -ExecutionPolicy Bypass -File companion/build-windows-installer.ps1",
    "test:companion": "node --test tests/windows-installer.test.mjs tests/codex-executable.test.mjs tests/codex-client.test.mjs tests/background.test.mjs",
    "test:bridge": "node --test tests/codex-client.test.mjs tests/claude-client.test.mjs tests/bridge-worker.test.mjs tests/claude-worker.test.mjs tests/background.test.mjs tests/workspace-cleanup.test.mjs tests/helper-workspace-removal.test.mjs tests/named-workspaces.test.mjs tests/named-workspace-integration.test.mjs",
    "test:helper-queue": "node --experimental-strip-types --test tests/helper-pairing.test.mjs tests/helper-queue.test.mjs tests/helper-ui.test.mjs tests/helper-cutover.test.mjs tests/helper-removals.test.mjs",
    "bridge:verify-app": "node --experimental-strip-types bridge/verify-app.mjs",
    "test:voice": "node --experimental-strip-types --test tests/speech-playback.test.mjs",
    "test:rounds": "node --experimental-strip-types --test tests/rounds.test.mjs",
    "test:view": "node --experimental-strip-types --test tests/round-view.test.mjs",
    "test": "npm run test:voice && npm run test:rounds && npm run test:view && npm run test:bridge && npm run test:helper-queue && npm run test:oauth",
    "test:oauth": "node --experimental-strip-types --test tests/oauth.test.mjs && node --experimental-strip-types --experimental-test-module-mocks --import ./tests/ts-resolve.mjs --test tests/oauth-flow.test.mjs"
  },
  "dependencies": {
    "@modelcontextprotocol/server": "^2.0.0",
    "@supabase/supabase-js": "^2.116.0",
    "ai": "^7.0.107",
    "mcp-handler": "^2.1.1",
    "next": "16.3.4",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1",
    "zod": "^4.6.1"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.8",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vercel/ncc": "^0.38.4",
    "babel-plugin-react-compiler": "1.0.0",
    "eslint": "^9",
    "eslint-config-next": "16.3.4",
    "tailwindcss": "^4",
    "typescript": "^5"
  }
}
